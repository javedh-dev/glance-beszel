<%# Main widget template -%>
<style>
  /* ── Base (applies at all sizes) ── */
  .bz-root{container-type:inline-size;container-name:bz}
  .bz-li{display:block}
  .bz-li[data-open] .details-arrow{transform:rotate(90deg)}

  /* Body hidden until expanded */
  .bz-li-body{display:none;margin-top:4px;flex-direction:column;gap:6px}
  .bz-li[data-open] .bz-li-body{display:flex}

  /* Service/docker state text hidden below 480px */
  .bz-svc-state-text{display:inline}
  @container bz (max-width:480px){
    .bz-svc-state-text{display:none}
  }

  /* ── Wide (≥600px): 3-column grid row ── */
  @container bz (min-width:600px){
    .bz-li-row{
      cursor:pointer;
      display:grid;
      grid-template-columns:minmax(0,1fr) minmax(0,26rem) 5rem;
      align-items:center;
      column-gap:12px;
      padding:6px 0;
    }
    .bz-name-col{display:flex;align-items:center;gap:6px;min-width:0;overflow:hidden}
    .bz-row1-right{display:none}
    .bz-bars-wide{display:block}
    .bz-bars-narrow{display:none}
    .bz-uptime-wide{
      display:flex;align-items:center;justify-content:flex-end;
      gap:6px;font-size:var(--font-size-base);
      color:var(--color-text-subdue);white-space:nowrap;
    }
    .bz-li-body{padding-left:20px}
    .bz-bars-wide .bz-row2{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px}
  }

  /* ── Narrow (<600px): single-row header, bars in body ── */
  @container bz (max-width:600px){
    .bz-li-row{
      cursor:pointer;
      display:flex;
      align-items:center;
      gap:6px;
      padding:6px 0;
    }
    .bz-name-col{display:flex;align-items:center;gap:6px;min-width:0;flex:1;overflow:hidden}
    .bz-row1-right{
      display:flex;flex-shrink:0;gap:6px;align-items:center;
      font-size:var(--font-size-base);color:var(--color-text-subdue);white-space:nowrap;
    }
    .bz-bars-wide{display:none}
    .bz-bars-narrow{display:block}
    .bz-uptime-wide{display:none}
    .bz-li-body{padding-left:14px}
    .bz-bars-narrow .bz-row2{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px}
  }

  /* ── Very narrow (<380px): tighten padding only ── */
  @container bz (max-width:380px){
    .bz-li-body{padding-left:8px}
  }
</style>

<% if (showAlerts && triggeredAlerts.length > 0) { %>
  <%- include('alert-banner', { alerts: triggeredAlerts, icons }) %>
<% } %>

<div class="bz-root">
<% if (bundles.length === 0) { %>
  <p class="color-subdue">No systems found.</p>
<% } else { %>
  <ul class="list collapsible-container"<% if (collapseAfter > 0) { %> data-collapse-after="<%= collapseAfter %>"<% } %>>
<% bundles.forEach(function(bundle) { %>
    <li class="bz-li"><%- include('system-entry', { bundle: bundle, beszelUrl: beszelUrl, icons: icons, resolveSystemIcon: resolveSystemIcon }) %></li>
<% }); %>
  </ul>
<% } %>
</div>
