<%# System entry partial — expects: bundle, beszelUrl, icons, resolveSystemIcon -%>
<%
  const s = bundle.system;
  const d = bundle.details;
  const info = s.info || {};
  const isUp = s.status === 'up';

  const statusColor = isUp ? 'var(--color-positive)' : (s.status === 'paused' ? 'var(--color-subdue)' : 'var(--color-negative)');
  const statusIcon  = s.status === 'paused' ? icons.CirclePause : icons.CircleX;
  const systemIcon  = resolveSystemIcon(s.name, d);
%>

<% if (!isUp) { %>

<%# ── Down / paused: simple single row, no expand ── -%>
<div style="display:flex;align-items:center;gap:8px;padding:4px 0">
  <span style="display:inline-flex;color:<%= statusColor %>"><%- statusIcon %></span>
  <span class="color-highlight size-h4"><%= s.name %></span>
  <% if (s.host) { %><span class="color-subdue size-h5">(<%= s.host %>)</span><% } %>
  <span class="color-subdue size-h5" style="margin-left:auto"><%= s.status === 'paused' ? 'paused' : 'unreachable' %></span>
</div>

<% } else {
  const cpuPct   = Math.round(info.cpu || 0);
  const memPct   = Math.round(info.mp  || 0);
  const diskPct  = Math.round(info.dp  || 0);
  const uptime   = info.u || info.t || 0;
  const svFailed = (info.sv && info.sv[1]) || 0;

  function fmtUptime(sec) {
    if (!sec) return '';
    const d = Math.floor(sec / 86400);
    const h = Math.floor((sec % 86400) / 3600);
    const m = Math.floor((sec % 3600) / 60);
    if (d > 0) return d + 'd ' + h + 'h';
    if (h > 0) return h + 'h ' + m + 'm';
    return m + 'm';
  }
  const uptimeStr = fmtUptime(uptime);
%>

<%# ── Header row: always clickable to toggle expand ── -%>
<div class="bz-li-row" onclick="this.closest('.bz-li').toggleAttribute('data-open')">

  <%# Col 1: arrow + OS icon + name + IP -%>
  <div class="bz-name-col">
    <%- icons.ChevronRight %>
    <%- systemIcon %>
    <span class="color-highlight size-h4" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0"><%= s.name %></span>
    <% if (s.host) { %><span class="color-subdue size-h5" style="white-space:nowrap;flex-shrink:0">(<%= s.host %>)</span><% } %>
    <%# Uptime — shown only on narrow -%>
    <div class="bz-row1-right">
      <% if (uptimeStr) { %><span><%= uptimeStr %></span><% } %>
      <% if (svFailed > 0) { %><span style="color:var(--color-negative)"><%= svFailed %>&#9888;</span><% } %>
    </div>
  </div>

  <%# Col 2 (wide only): stat bars -%>
  <div class="bz-bars-wide">
    <%- include('stat-bars', { cpuPct, memPct, diskPct, icons }) %>
  </div>

  <%# Col 3 (wide only): uptime right-aligned -%>
  <div class="bz-uptime-wide">
    <% if (uptimeStr) { %><span><%= uptimeStr %></span><% } %>
    <% if (svFailed > 0) { %><span style="color:var(--color-negative)"><%= svFailed %>&#9888;</span><% } %>
  </div>

</div>

<%# ── Expanded body ── -%>
<div class="bz-li-body">

  <%# Stat bars — narrow only -%>
  <div class="bz-bars-narrow">
    <%- include('stat-bars', { cpuPct, memPct, diskPct, icons }) %>
  </div>

  <% if (bundle.containers.length > 0) { %>
    <%- include('containers', { containers: bundle.containers, icons }) %>
  <% } %>
  <% if (bundle.services.length > 0) { %>
    <%- include('services', { services: bundle.services, icons }) %>
  <% } %>
  <% if (bundle.smartDevices.length > 0) { %>
    <%- include('smart-devices', { disks: bundle.smartDevices, icons }) %>
  <% } %>

</div>

<% } /* end isUp */ %>
