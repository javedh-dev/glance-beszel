<%# Alert banner partial — expects: alerts (AlertRecord[]), icons -%>
<div class="flex items-center gap-10 margin-bottom-widget" style="color:var(--color-negative)">
  <%- icons.TriangleAlert %>
  <span class="size-h5 color-negative">Alerts:
    <% alerts.slice(0, 3).forEach(function(a, i) { %>
      <% if (i > 0) { %>, <% } %><span class="color-highlight"><%= a.name %></span>
    <% }); %>
    <% if (alerts.length > 3) { %>, +<%= alerts.length - 3 %> more<% } %>
  </span>
</div>
