<%# Smart devices / disks partial — expects: disks (SmartDeviceRecord[]), icons -%>
<%
  function fmtBytes(bytes) {
    if (!bytes || bytes === 0) return '0 B';
    var units = ['B', 'KB', 'MB', 'GB', 'TB'];
    var i = Math.floor(Math.log(bytes) / Math.log(1024));
    var val = bytes / Math.pow(1024, i);
    return val.toFixed(val < 10 ? 1 : 0) + ' ' + units[i];
  }
%>
<details class="bz" style="width:100%">
  <summary class="bz-sum" style="display:flex;align-items:center;gap:6px;padding:4px 0;cursor:pointer">
    <%- icons.ChevronRight %>
    <span style="display:inline-flex;color:var(--color-text-subdue)"><%- icons.HardDrive %></span>
    <span style="font-size:var(--font-size-h5);color:var(--color-text-subdue);text-transform:uppercase;letter-spacing:.05em">Disks</span>
    <span style="font-size:var(--font-size-h5);color:var(--color-text-subdue);margin-left:4px"><%= disks.length %></span>
  </summary>
  <div style="margin-top:6px;padding-left:14px">
    <div style="display:grid;grid-template-columns:1fr auto auto;gap:4px 12px;align-items:center">
      <%# Header -%>
      <div style="font-size:var(--font-size-h5);color:var(--color-text-subdue);padding-bottom:3px">DEV</div>
      <div style="font-size:var(--font-size-h5);color:var(--color-text-subdue);padding-bottom:3px;text-align:right">SIZE</div>
      <div style="font-size:var(--font-size-h5);color:var(--color-text-subdue);padding-bottom:3px;text-align:right">TEMP</div>

      <%# Rows -%>
      <% disks.forEach(function(d) {
        var passed     = /passed/i.test(d.state);
        var isFailed   = /failed/i.test(d.state);
        var stateColor = isFailed ? 'var(--color-negative)' : (passed ? 'var(--color-positive)' : 'var(--color-text-subdue)');
        var stateIcon  = isFailed ? icons.CircleX : (passed ? icons.CircleCheck : icons.CircleMinus);
        var ageYears   = d.hours ? Math.round((d.hours / 24 / 365.25) * 10) / 10 : null;
      %>
      <%# Cell 1: status icon + name + state/model -%>
      <div style="display:flex;align-items:center;gap:8px;min-width:0;overflow:hidden">
        <span style="display:inline-flex;flex-shrink:0;color:<%= stateColor %>"><%- stateIcon %></span>
        <span style="font-size:var(--font-size-h5);color:var(--color-text-highlight);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex-shrink:1"><%= d.name %><% if (d.model) { %> <span style="color:var(--color-text-subdue)">(<%= d.model %>)</span><% } %></span>
        <span class="bz-svc-state-text" style="font-size:var(--font-size-h5);color:<%= stateColor %>;white-space:nowrap;flex-shrink:0;margin-left:auto"><%= d.state || '—' %><% if (ageYears !== null) { %> &middot; <%= ageYears %>yr<% } %></span>
      </div>
      <%# Cell 2: SIZE -%>
      <div style="font-size:var(--font-size-h5);color:var(--color-text-subdue);text-align:right;white-space:nowrap"><%= d.capacity ? fmtBytes(d.capacity) : '—' %></div>
      <%# Cell 3: TEMP -%>
      <div style="font-size:var(--font-size-h5);color:var(--color-text-subdue);text-align:right;white-space:nowrap"><%= d.temp ? d.temp + '°C' : '—' %></div>
      <% }); %>
    </div>
  </div>
</details>
