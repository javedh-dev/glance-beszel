# -------------------------------------------------------
# Glance Beszel Extension — environment configuration
# Copy this file to .env and fill in your values
# -------------------------------------------------------

# --- Required ---
BESZEL_URL=http://localhost:8090
BESZEL_EMAIL=admin@example.com
BESZEL_PASSWORD=your-password

# --- Server ---
PORT=8088

# --- Widget appearance ---
WIDGET_TITLE=Beszel
WIDGET_TITLE_URL=http://localhost:8090   # clicked title opens Beszel; defaults to BESZEL_URL

# --- Display options ---
SHOW_ALERTS=true        # show triggered alert banner
COLLAPSE_AFTER=0        # 0 = show all; N = collapse list after N systems

# --- Performance ---
CACHE_TTL=30            # seconds to cache the rendered widget; 0 = disable (re-fetches on every request)

# --- Filtering ---
# SYSTEM_FILTER: comma-separated system names, e.g.  pbs,nexus,glance
#   or a raw PocketBase filter expression (detected by presence of = ~ < > ( ) & |)
#   e.g.  name~"prod"
SYSTEM_FILTER=          # e.g. pbs,nexus  or  name~"gateway"
STATUS_FILTER=          # quick status filter: "up", "down", or empty for all

# --- GitHub Copilot (optional) ---
# Generate a PAT at https://github.com/settings/tokens with read:billing scope
GH_TOKEN=               # GitHub Personal Access Token
GH_USERNAME=            # Your GitHub username

COPILOT_WIDGET_TITLE=GitHub Copilot
COPILOT_CACHE_TTL=300       # seconds to cache Copilot usage data
COPILOT_CREDITS=1500        # total monthly AI credits allowed
COPILOT_CREDIT_VALUE=0.01   # dollar value per credit

# --- OpenRouter (optional) ---
OPENROUTER_API_KEY=sk-or-v1-...   # OpenRouter API key (shows credit balance)
OPENROUTER_WIDGET_TITLE=OpenRouter Credits
OPENROUTER_CACHE_TTL=300
